        <!-- Confirms before Open replaces whatever is already loaded (spec's own flagged gap —
             see OpenButton_Click). Gated on "is there anything to lose", not exact dirty-tracking:
             several edit paths (e.g. a tile's duration NumberBox) don't go through the undo stack,
             so tracking real dirty state precisely would risk missing one and silently not warning
             — the coarser check can only ever over-warn, never under-warn. DefaultButton is the
             Cancel side so pressing Enter can't discard by accident. -->
        <ContentDialog
            x:Name="DiscardChangesDialog"
            x:Uid="DiscardChangesDialog"
            DefaultButton="Close"/>
    </Grid>
</Window>
