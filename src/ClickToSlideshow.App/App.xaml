<Application
    x:Class="ClickToSlideshow.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!-- The surface palette and IconButtonStyle are shared by every Bureau app and live in
                 the Bureau.Common submodule (external/Bureau.Common). Edit them there, not here. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///Bureau.Common/Themes/Palette.xaml"/>
                <ResourceDictionary Source="ms-appx:///Bureau.Common/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One per section header (audio-section-brief.md §3.10) — a filled accent circle
                 with a glyph, ClickTo: PDF's own add affordance. Sized smaller than PDF's (~30px
                 vs. its floating FAB) since this one sits level with header text rather than
                 floating over empty space. -->
            <Style x:Key="AddSectionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Runtime footer's audio bar (audio-section-brief.md §4) — amber against the
                 slideshow bar's accent blue, matching the brief's own mockup. The same in both
                 themes, so it needs no theme dictionary. -->
            <SolidColorBrush x:Key="AppAudioAccentBrush" Color="#FFB900"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
