<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name, Publisher and PublisherDisplayName are the Partner Center Product identity values
       for this app (confirmed 2026-09-26); Publisher is per account, so it is the same as
       ClickTo: PDF's. Publisher must match the dev cert's Subject exactly for Add-AppxPackage
       to accept a local sideload. -->
  <!-- 1.0.0.0 was once a placeholder, then reset to a 0.x pre-release scheme, and is now the
       first release. AppX refuses to install a version lower than or equal to one already
       registered for this Name+Publisher, so a machine still carrying the original placeholder
       1.0.0.0 dev install needs Remove-AppxPackage first. Bump forward from here, never back. -->
  <Identity
    Name="TheBureauofStuff.ClickToSlideshow"
    Publisher="CN=6ACAA7C7-CCDB-4E63-ABCE-1383DE9B3AE4"
    Version="1.0.2.0" />

  <Properties>
    <!-- Must match a name reserved in Partner Center character-for-character, or
         submission fails identity validation. -->
    <DisplayName>ClickTo: Slideshow</DisplayName>
    <PublisherDisplayName>The Bureau of Stuff</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- Framework-dependent WindowsAppSDK deployment (ClickToSlideshow.App.csproj has
         WindowsAppSDKSelfContained=false): Windows resolves Microsoft.UI.Xaml's WinRT
         activation through this separately-installed runtime package, not through our own
         payload or a bootstrap call. Without this, WinUI activation fails at startup with
         REGDB_E_CLASSNOTREG. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.3.1.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <!-- BackgroundColor is the plate Windows paints behind the Start tile assets. The
           Square71/150/310 and Wide310x150 images are deliberately glyph-only on
           transparency so this colour forms the tile; Square44x44 and StoreLogo carry
           their own plate because they render standalone in the taskbar and Store. -->
      <uap:VisualElements
        DisplayName="ClickTo: Slideshow"
        Description="Turn photos and music into a slideshow straight from the right-click menu. Set timing and transitions, play it fullscreen, or save as a video. All on your own PC — nothing is ever uploaded."
        BackgroundColor="#0F6E63"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.png"
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Manifest-based COM registration — no registry writes. Resolves the same CLSID
             (ClickToSlideshow.ShellExtension\Guid.h) to the packaged DLL via a surrogate host
             process, the standard mechanism for a native shell extension inside an MSIX
             package. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="ClickTo: Slideshow Shell Extension">
              <com:Class Id="C9E2689D-69D4-4A4F-85B0-9F7CFA6F3726" Path="ClickToSlideshow.ShellExtension\ClickToSlideshow.ShellExtension.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Type="*" covers files, Type="Directory" covers a directly-selected folder — both
             point at the same verb/CLSID so GetState remains the sole dynamic decider for
             mixed or folder selections (spec §4.1). "Directory" is only valid under the
             desktop5 schema (desktop4:ItemType's Type is restricted to "*" or ".ext"). -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ClickToSlideshow" Clsid="C9E2689D-69D4-4A4F-85B0-9F7CFA6F3726" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ClickToSlideshow" Clsid="C9E2689D-69D4-4A4F-85B0-9F7CFA6F3726" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
